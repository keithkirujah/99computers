    { "source": "/", "destination": "/index.html" },
    { "source": "/shop", "destination": "/index.html" },
    { "source": "/shop/c/:path*", "destination": "/index.html" },
    { "source": "/shop/p/:id", "destination": "/api/shop/p/[id]" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/why", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ]
}